# 이 파일을 .env로 복사하고 필요한 값을 채운 뒤 서버를 재시작하세요.

# 최초 최고관리자(super_admin) 계정 — data/users.json에 계정이 하나도 없을 때만
# 서버 기동 시 자동 생성된다. 계정이 이미 있으면 이 값은 무시된다.
SUPERADMIN_USERNAME=
SUPERADMIN_PASSWORD=

# --- 개발용 간편 로그인(로컬 개발·데모 전용, 외부 공개 환경에서는 비워둘 것) -------------
# 로그인 화면의 "빠른 로그인" 버튼이 쓰는 계정. 아이디·비밀번호가 둘 다 있어야 버튼이 보인다.
# 비밀번호는 서버에서만 읽고 브라우저로 보내지 않는다. 계정은 아래 스크립트로 만든다:
#   python scripts/create_demo_accounts.py
# DEMO_ADMIN_USERNAME=
# DEMO_ADMIN_PASSWORD=
# 사용자 모바일웹(/app) 개발용 — 차량 등록자 계정. 연결 차량은 DEMO_OWNER_EV_ID(기본 EV-001)
# DEMO_OWNER_USERNAME=
# DEMO_OWNER_PASSWORD=
# DEMO_OWNER_EV_ID=EV-003   # 시뮬레이션 차량 중 방전(V2G) 가능 차종(차종B SUV). EV-001은 방전 불가 차종이라 충전 시간 조절만 나온다

# 로그인 세션 쿠키 서명용 비밀키. 비워두면 서버 재시작마다 무작위로 새로 생성되어
# 기존 로그인 세션이 전부 풀린다 — 운영 중 유지하려면 임의의 긴 문자열을 고정해두세요.
SESSION_SECRET=

# --- OBD 수집: TOAST Object Storage (읽기 전용 계정 권장) ---------------------------
# TOAST_TENANT_ID=
# TOAST_USERNAME=
# TOAST_PASSWORD=
# TOAST_ENDPOINT=https://api-storage.cloud.toast.com/v1/AUTH_<tenant id>
# TOAST_BUCKET=

# --- 운영 보안/동작 스위치 ---------------------------------------------------------
# OCPP_AUTH_REQUIRED=1        # 충전기 접속 인증 강제(외부 공개 전 필수)
# OCPP_MAX_CONNECTIONS=400
# CONSENT_ENFORCE=1           # 수집 동의 없는 차량의 OBD 파일 처리 보류
# DISCHARGE_RECORD_KIND=V2G   # 실차 운영 시에만(기본 TEST)
# OBD_BATCH_MODE=shadow       # live 전환은 1대부터 OBD_BATCH_LIVE_EVS로
# PSEUDO_KEY=                 # 가명화 키(미설정 시 data/.pseudo_key 자동 생성)

# --- 로그인 보호 · 외부 공개 --------------------------------------------------------
# 로그인·비밀번호 확인 실패가 누적되면 잠근다(429). 계정별 한도·IP별 한도·집계 창(초)·잠금 시간(초)
# LOGIN_MAX_FAILS=8
# LOGIN_MAX_FAILS_PER_IP=40
# LOGIN_WINDOW_S=600
# LOGIN_LOCK_S=600
# HTTPS로 공개할 때: 세션 쿠키에 Secure·HSTS(SESSION_HTTPS_ONLY), 터널·프록시 뒤에서 실제 접속지 사용(TRUST_PROXY_HEADERS)
# SESSION_HTTPS_ONLY=1
# TRUST_PROXY_HEADERS=1
# 기본 주소(/)가 이동할 곳(기본 /dashboard). 외부 공개 데모는 /dev(진입 페이지)
# ROOT_REDIRECT=/dashboard
# 이용자 전용 데모 링크: /auth/demo-access?code=<DEMO_ACCESS_TOKEN> 로 들어오면 DEMO_ACCESS_OWNER(이용자 역할만)로 로그인.
# 비밀 코드이므로 긴 무작위 값을 쓰고 공개 문서에 적지 않는다. 비워두면 이 경로는 404.
# DEMO_ACCESS_TOKEN=
# DEMO_ACCESS_OWNER=demo-owner

# --- 공공데이터포털 인증키(기상청 ASOS 기온·한국천문연구원 공휴일) -----------------------------
# data.go.kr에서 두 API를 활용신청한 뒤 받은 인증키(일반 인증키, Decoding). 비워 두면 수집 API가 503으로 이유를 알려 준다.
DATA_GO_KR_SERVICE_KEY=
