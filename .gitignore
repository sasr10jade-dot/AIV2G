__pycache__/
*.pyc
data/
output/
.venv/
.pytest_cache/
.env

# 실차 OBD 원본(차량번호 포함, 대용량) — 버전관리 제외
OBDData/
# Office 임시 잠금 파일, 수동 백업 폴더(git 이력으로 대체)
~$*
Report/_backup_*/

# 공개 저장소 제외 — 계획서·명세서·발표자료 등 문서 파일
*.pdf
*.xlsx
*.pptx
*.docx
*.hwp
*.hwpx

# 안드로이드 앱 빌드 산출물(소스는 저장소에 둔다)
android/.gradle/
android/build/
android/app/build/
android/local.properties
*.jks
*.keystore
*.apk
*.aab
*.idsig

# 배포용 앱 파일(APK) — 저장소에 올리지 않고 서버의 downloads/ 에만 둔다
downloads/
